// /home/user/saas/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  // The 'output' line has been removed or commented out.
  // Prisma will now generate the client to the default location:
  // node_modules/.prisma/client
}

datasource db {
  provider = "postgresql" // Ensure this is "postgresql"
  url      = env("DATABASE_URL")
}

// Your Tenant and User models (with phoneNumber)
model Tenant {
  id          String @id @default(cuid())
  subdomain   String @unique
  name        String
  tenant_type String

  primaryColor String?
  logoUrl      String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id          String   @id @default(cuid())
  email       String
  password    String   // Hashed password
  name        String?
  phoneNumber String?  // Added phone number, optional
  role        String   // e.g., "admin", "manager", "member"

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
}